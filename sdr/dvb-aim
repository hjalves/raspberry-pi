#!/usr/bin/env python3
"""dvb-aim: live DVB-T channel levels for pointing an antenna.

usage: dvb-aim [-c 43,45,48] [-i SECONDS] [--lock-every N] [-g GAIN]

Each pass measures every channel's level in dB above the noise floor with rtl_power, which
works without a DVB lock (this dongle's DVB driver reports no signal statistics at all until it
locks). Every N passes (--lock-every, 0 = never) it loads the DVB-T driver and asks dvbv5-zap
for lock, signal and C/N on each channel (this pauses the live readings for ~5 s per channel).

readsb is stopped while this runs and restarted on exit (Ctrl-C included).
Rough guide: DVB-T 64-QAM needs about 18-20 dB C/N to decode cleanly.
"""
import argparse
import os
import re
import signal
import subprocess
import sys
import tempfile
import time

DVB_MODS = ["dvb_usb_rtl28xxu", "rtl2832_sdr", "rtl2832", "r820t"]
ADAPTER = "/dev/dvb/adapter0"


def ch_freq(ch):
    """UHF channel centre frequency in Hz (Europe, 8 MHz raster)."""
    return (306 + 8 * ch) * 1_000_000


def loaded(mod):
    with open("/proc/modules") as f:
        return any(line.split()[0] == mod for line in f)


def unload_dvb():
    for _ in range(4):
        left = [m for m in DVB_MODS if loaded(m)]
        if not left:
            return
        for m in left:
            subprocess.run(["modprobe", "-r", m], stderr=subprocess.DEVNULL)


def measure(chans, interval, gain):
    """One rtl_power pass; returns {ch: dB above floor} and the floor in dBFS."""
    lo = min(ch_freq(c) for c in chans) - 8_000_000
    hi = max(ch_freq(c) for c in chans) + 8_000_000
    out = subprocess.run(
        ["rtl_power", "-f", f"{lo}:{hi}:100k", "-g", str(gain), "-i", str(interval),
         "-1", "-c", "0.2", "-"],
        capture_output=True, text=True).stdout
    bins = []
    for line in out.splitlines():
        p = [x.strip() for x in line.split(",")]
        if len(p) < 7:
            continue
        f0, step = float(p[2]), float(p[4])
        for i, v in enumerate(p[6:]):
            try:
                bins.append((f0 + (i + 0.5) * step, float(v)))
            except ValueError:
                pass
    if not bins:
        return None, None
    allv = sorted(v for _, v in bins)
    floor = allv[int(len(allv) * 0.15)]
    res = {}
    for c in chans:
        fc = ch_freq(c)
        inb = sorted(v for f, v in bins if abs(f - fc) < 3.6e6)
        res[c] = (inb[len(inb) // 2] - floor) if inb else None
    return res, floor


def lock_check(chans):
    """Load the DVB driver, ask dvbv5-zap for stats per channel, unload again."""
    subprocess.run(["modprobe", "dvb_usb_rtl28xxu"], check=True)
    for _ in range(20):
        if os.path.exists(ADAPTER + "/frontend0"):
            break
        time.sleep(0.5)
    with tempfile.NamedTemporaryFile("w", suffix=".conf", delete=False) as t:
        for c in chans:
            t.write(f"[CH{c}]\n\tDELIVERY_SYSTEM = DVBT\n\tFREQUENCY = {ch_freq(c)}\n"
                    "\tBANDWIDTH_HZ = 8000000\n\tCODE_RATE_HP = AUTO\n\tCODE_RATE_LP = AUTO\n"
                    "\tMODULATION = QAM/AUTO\n\tTRANSMISSION_MODE = AUTO\n"
                    "\tGUARD_INTERVAL = AUTO\n\tHIERARCHY = NONE\n\tINVERSION = AUTO\n\n")
        conf = t.name
    res = {}
    try:
        for c in chans:
            r = subprocess.run(["timeout", "5", "dvbv5-zap", "-c", conf, "-m", f"CH{c}"],
                               capture_output=True, text=True)
            lines = [x.strip() for x in re.split(r"[\r\n]", r.stdout + r.stderr) if x.strip()]
            stat = [x for x in lines if "Lock" in x or "(0x" in x]
            s = stat[-1] if stat else ""
            if "Lock" in s:
                sig = re.search(r"Signal=\s*([-\d.]+\s*\S+)", s)
                cn = re.search(r"C/N=\s*([-\d.]+\s*dB)", s)
                res[c] = "LOCK" + (f" sig {sig.group(1)}" if sig else "") + (f" C/N {cn.group(1)}" if cn else "")
            else:
                res[c] = "no lock"
    finally:
        os.unlink(conf)
        unload_dvb()
    return res


def bar(db, scale=1.0, width=25):
    if db is None:
        return "?"
    n = max(0, min(width, int(round(db * scale))))
    return "█" * n + "·" * (width - n)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-c", "--channels", default="43,45,48", help="UHF channels (default 43,45,48)")
    ap.add_argument("-i", "--interval", type=float, default=1, help="rtl_power integration seconds per pass")
    ap.add_argument("--lock-every", type=int, default=5, help="lock check every N passes (0 = never)")
    ap.add_argument("-g", "--gain", type=float, default=40, help="tuner gain in dB (default 40)")
    a = ap.parse_args()
    if os.geteuid() != 0:
        os.execvp("sudo", ["sudo", sys.argv[0]] + sys.argv[1:])
    chans = [int(x) for x in a.channels.split(",")]

    def restore(*_):
        print("\nrestoring ADS-B mode...", flush=True)
        unload_dvb()
        subprocess.run(["systemctl", "start", "readsb"])
        print("readsb:", subprocess.run(["systemctl", "is-active", "readsb"],
                                        capture_output=True, text=True).stdout.strip())
        sys.exit(0)

    signal.signal(signal.SIGINT, restore)
    signal.signal(signal.SIGTERM, restore)
    subprocess.run(["systemctl", "stop", "readsb"], check=True)
    unload_dvb()
    print(f"readsb stopped. Channels {', '.join(map(str, chans))}; dB above noise floor "
          f"(each █ = 1 dB). Ctrl-C to stop and restore ADS-B.", flush=True)
    best = {c: None for c in chans}
    n = 0
    while True:
        n += 1
        res, floor = measure(chans, a.interval, a.gain)
        if res is None:
            print("rtl_power returned no data (is the dongle busy?)", flush=True)
            time.sleep(2)
            continue
        print(time.strftime("%H:%M:%S") + f"  floor {floor:6.1f} dBFS", flush=True)
        for c in chans:
            v = res[c]
            if v is not None and (best[c] is None or v > best[c]):
                best[c] = v
            vs = f"{v:+5.1f} dB" if v is not None else "   ?    "
            bs = f"{best[c]:+.1f}" if best[c] is not None else "?"
            print(f"  ch{c} {ch_freq(c)//1_000_000} MHz  {vs}  {bar(v)}  best {bs}", flush=True)
        if a.lock_every and n % a.lock_every == 0:
            for c, s in lock_check(chans).items():
                print(f"  ch{c} dvbv5: {s}", flush=True)


if __name__ == "__main__":
    main()
